# ── Target backend (the Resonate staging/test deploy the harness drives) ─────
# The deterministic-scorer demo needs NONE of this. These are for the live runner.
RESONATE_BASE_URL=http://localhost:8000
RESONATE_DEV_EMAIL=harness-operator@example.com   # X-Dev-User-Email auto-provisions a throwaway org+project
# A guard refuses a production hostname unless a real bearer token is supplied:
RESONATE_BEARER_TOKEN=

# ── Council + judge model keys (used via LiteLLM) ───────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=     # Kimi
XAI_API_KEY=          # Grok

# ── Hard budget ceilings (kill-switches) ────────────────────────────────────
COUNCIL_BUDGET_USD=30          # council + judge spend, enforced by LiteLLM
BACKEND_DRAFT_BUDGET_USD=15    # Resonate's own draft spend, summed from spend_events

# ── Run controls ────────────────────────────────────────────────────────────
MAX_CONCURRENCY=8
SIM_COUNT=50
